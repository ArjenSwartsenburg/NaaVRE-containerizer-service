name: venv
channels:
  - conda-forge
dependencies:
{% if python_version %}
  - python={{ python_version }}
{% endif %}
  - pip
  - nbconvert
{% for d in conda_deps %}
  - {{ d }}
{% endfor %}
{% if pip_deps|length > 0 %}
  - pip:
  {% for d in pip_deps %}
    - {{ d }}
  {% endfor %}
{% endif %}
  - papermill
  - ipykernel